# Copy to .env and fill in real values. Do not commit .env.

# Supabase — database password (migrations, CLI, direct Postgres access) https://app.supabase.com/project/rfunicjeleyzttwtlbyg/settings/database
SUPABASE_DB_PASSWORD=


# Supabase — client (Project URL → Settings → API) https://app.supabase.com/project/rfunicjeleyzttwtlbyg/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# Supabase — service role key (migrations, CLI, direct Postgres access) https://app.supabase.com/project/rfunicjeleyzttwtlbyg/settings/api
SUPABASE_SERVICE_ROLE_KEY=


# Resend — API key https://resend.com/api-keys
RESEND_API_KEY=


# Resend — sender address (use a verified domain in production; onboarding@resend.dev only sends to your own email)
RESEND_FROM_EMAIL=onboarding@resend.dev


# App base URL
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
