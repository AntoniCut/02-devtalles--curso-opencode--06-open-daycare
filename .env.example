# Copy this file to the env file of the environment you are working on.
# Never commit real values.

# ---------------------------------------------------------------------------
# Desarrollo (OpenDayCare-Dev, ref rfunicjeleyzttwtlbyg)
#
# Copiar a `.env.local` (gitignored). Next.js le da prioridad sobre `.env`,
# así que `pnpm dev` trabaja contra el proyecto de desarrollo.
# ---------------------------------------------------------------------------

# Supabase — database password (migrations, CLI, direct Postgres access)
# https://app.supabase.com/project/rfunicjeleyzttwtlbyg/settings/database
SUPABASE_DB_PASSWORD=

# Supabase — client (Project URL → Settings → API Keys)
# https://app.supabase.com/project/rfunicjeleyzttwtlbyg/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App base URL
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Producción (OpenDayCare-Prod, ref mdoftqngmqmijmowqqak)
#
# Local: copiar a `.env` (gitignored). En Vercel las variables viven en
# Settings → Environment Variables (no se usa archivo).
# ---------------------------------------------------------------------------

# SUPABASE_DB_PASSWORD=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_APP_BASE_URL=


# ---------------------------------------------------------------------------
# Compartido por ambos entornos
# ---------------------------------------------------------------------------

# Resend — API key https://resend.com/api-keys
RESEND_API_KEY=

# Resend — sender address (use a verified domain in production; onboarding@resend.dev only sends to your own email)
RESEND_FROM_EMAIL=onboarding@resend.dev
