{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "command": {
        "spec": {
            "description": "Crea especificaciones de pantallas y funcionalidades",
            "template": "Carga y sigue la skill spec en .agents/skills/spec/SKILL.md.\n\nFeature: $ARGUMENTS"
        }
    },
    "references": {
        "db-schema": {
            "path": "../07-db-Schema",
            "description": "Esquema de base de datos, tablas, columnas y referencias a crear, esto no esta implementado en la base de datos, solo es para referencia"
        }
    },
    "permission": {
        "external_directory": {
            "/tmp/**": "allow"
        },
        "bash": "allow"
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ],
            "enabled": true
        },
        "supabase": {
            "type": "remote",
            "url": "https://mcp.supabase.com/mcp?project_ref=rfunicjeleyzttwtlbyg&read_only=false&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
            "enabled": true
        }
    }
}